# Saans Environment Variables Configuration Template
# Copy this file to .env and adjust values for your deployment

# AWS Deployment Region
APP_REGION=ap-south-1

# DynamoDB Single Table Name (populated by SAM stack)
TABLE_NAME=SaansStateTable

# Default GRAP stage if unspecified (I, II, III, IV)
DELHI_STAGE_DEFAULT=III

# Telegram Bot Webhook Secret Token (Must match your bot's setWebhook secret_token)
TELEGRAM_SECRET_TOKEN=set_a_secure_random_token_here_for_webhook_verification

# Bedrock Model Configuration
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
