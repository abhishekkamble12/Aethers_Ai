{
  "Comment": "Saans: plan -> principal approval (60 s) -> vice-principal escalation (60 s) -> notices, or fail safe with no broadcast",
  "StartAt": "LoadContext",
  "States": {
    "LoadContext": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${IngestPlannerFunctionArn}",
        "Payload": {
          "tenant_id.$": "$.tenant_id",
          "date.$": "$.date",
          "stage.$": "$.stage",
          "session.$": "$.session",
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "decision.$": "$.Payload.decision",
        "audit_head.$": "$.Payload.audit_head",
        "receipt_id.$": "$.Payload.receipt_id"
      },
      "ResultPath": "$.planner_output",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "CheckIfInterventionNeeded"
    },
    "CheckIfInterventionNeeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.planner_output.decision.status",
          "StringEquals": "confirmed_no_change",
          "Next": "AuditCloseNoChange"
        }
      ],
      "Default": "RequestPrincipalApproval"
    },
    "RequestPrincipalApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${RequestApprovalFunctionArn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "escalation": false,
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultPath": "$.approval_result",
      "TimeoutSeconds": 60,
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.approval_result_timeout",
          "Next": "EscalateToVicePrincipal"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_info",
          "Next": "FailSafeError"
        }
      ],
      "Next": "UsePrincipalAnswer"
    },
    "EscalateToVicePrincipal": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${RequestApprovalFunctionArn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "escalation": true,
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultPath": "$.escalated_approval_result",
      "TimeoutSeconds": 60,
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.escalated_approval_result_timeout",
          "Next": "FailSafeTimeout"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_info",
          "Next": "FailSafeError"
        }
      ],
      "Next": "UseVicePrincipalAnswer"
    },
    "UsePrincipalAnswer": {
      "Type": "Pass",
      "InputPath": "$.approval_result",
      "ResultPath": "$.final_approval",
      "Next": "ProcessDecisionAction"
    },
    "UseVicePrincipalAnswer": {
      "Type": "Pass",
      "InputPath": "$.escalated_approval_result",
      "ResultPath": "$.final_approval",
      "Next": "ProcessDecisionAction"
    },
    "ProcessDecisionAction": {
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            {
              "Variable": "$.final_approval.action",
              "StringEquals": "APPROVE_PLAN_A"
            },
            {
              "Variable": "$.final_approval.action",
              "StringEquals": "APPROVE_PLAN_B"
            }
          ],
          "Next": "DraftAndDispatchNotices"
        }
      ],
      "Default": "FailSafeRejected"
    },
    "DraftAndDispatchNotices": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NotificationFunctionArn}",
        "Payload": {
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "approval.$": "$.final_approval",
          "stage.$": "$.planner_output.decision.declared_stage",
          "plan.$": "$.planner_output.decision",
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "notices.$": "$.Payload"
      },
      "ResultPath": "$.dispatch_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_info",
          "Next": "FailSafeError"
        }
      ],
      "Next": "AuditCloseApproved"
    },
    "AuditCloseNoChange": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AuditFunctionArn}",
        "Payload": {
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "execution.$": "$$.Execution.Name",
          "event": "RUN_CLOSED_NO_CHANGE"
        }
      },
      "ResultSelector": {
        "audit.$": "$.Payload"
      },
      "ResultPath": "$.audit_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "AuditCloseApproved": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AuditFunctionArn}",
        "Payload": {
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "execution.$": "$$.Execution.Name",
          "event": "RUN_CLOSED_APPROVED_AND_NOTIFIED",
          "action.$": "$.final_approval.action",
          "approver_role.$": "$.final_approval.approver_role"
        }
      },
      "ResultSelector": {
        "audit.$": "$.Payload"
      },
      "ResultPath": "$.audit_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "FailSafeRejected": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AuditFunctionArn}",
        "Payload": {
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "execution.$": "$$.Execution.Name",
          "event": "REJECTED_NO_BROADCAST",
          "action.$": "$.final_approval.action",
          "approver_role.$": "$.final_approval.approver_role"
        }
      },
      "ResultSelector": {
        "audit.$": "$.Payload"
      },
      "ResultPath": "$.audit_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "FailSafeTimeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AuditFunctionArn}",
        "Payload": {
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "execution.$": "$$.Execution.Name",
          "event": "FAILSAFE_TIMEOUT_NO_BROADCAST",
          "reason": "Principal and vice-principal did not answer in time; no notice sent"
        }
      },
      "ResultSelector": {
        "audit.$": "$.Payload"
      },
      "ResultPath": "$.audit_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "FailSafeError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AuditFunctionArn}",
        "Payload": {
          "tenant_id.$": "$.tenant_id",
          "decision_id.$": "$.planner_output.decision.decision_id",
          "execution.$": "$$.Execution.Name",
          "event": "WORKFLOW_ERROR_NO_BROADCAST",
          "error.$": "$.error_info.Error",
          "cause.$": "$.error_info.Cause"
        }
      },
      "ResultSelector": {
        "audit.$": "$.Payload"
      },
      "ResultPath": "$.audit_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}
